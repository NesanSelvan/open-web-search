# --- service ---
# The one API key. Every route except /health requires it as `X-API-Key`.
# The service refuses to start while this is empty. Generate one with:
#   openssl rand -hex 32
WS_API_KEY=
WS_HOST=0.0.0.0
WS_PORT=8080
WS_LOG_LEVEL=INFO

# --- identity pool ---
# One line per identity: id|proxy_url|country
# proxy_url may be empty to use the host IP (dev only — Google will block it fast).
# Example: id1|http://user:pass@gate.provider.net:7777|IN
WS_IDENTITIES_FILE=config/identities.txt
WS_PROFILE_ROOT=/var/lib/open-web-search/profiles
WS_COOLDOWN_MIN_S=20
WS_COOLDOWN_MAX_S=45
WS_QUARANTINE_STEPS_S=300,1800,14400
WS_RETIRE_BLOCK_RATE=0.4
WS_RETIRE_WINDOW=20
WS_ACQUIRE_TIMEOUT_S=90

# --- chrome ---
# "chrome" uses the real Google Chrome build (required — Chromium is detected).
WS_CHROME_CHANNEL=chrome
WS_HEADLESS=false

# --- search ---
WS_SEARCH_MAX_RETRIES=3
WS_SEARCH_RESULTS=10

# --- scrape ---
WS_SCRAPE_CONCURRENCY=5
# --- locale / market -------------------------------------------------------
# Neutral by default. The engine has no opinion about which market you are
# searching — set these for yours.
WS_LOCALE=en-US
WS_TIMEZONE=UTC
WS_ACCEPT_LANGUAGE=en-US,en;q=0.9
WS_DEFAULT_COUNTRY=US
# Appended to every bare query. Empty = search exactly what was typed. Set it only
# to aim a whole deployment at one kind of result.
WS_QUERY_SUFFIX=
# Only used for domains marked needs_residential (which store a shop shows you).
WS_DEFAULT_GEO_LAT=0
WS_DEFAULT_GEO_LNG=0

# Per-domain policy. The default is generic; config/domains.india.example.yaml
# shows what a market-specific overlay looks like.
WS_DOMAINS_FILE=config/domains.yaml

# --- cache ---
WS_DB_PATH=/var/lib/open-web-search/cache.db
